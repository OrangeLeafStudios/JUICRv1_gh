ses[cur_ses_key] = {}

TitleScreen()

dependencies = LibGrab()
metaxploit = dependencies[0]
cryptools = dependencies[1]

TryLaunch = function(fileobj)
	if fileobj.is_binary then
		sh.launch((fileobj.path), prg_param)
	else
		print(fileobj.name+": is not a program")
	end if
end function

PrintTree = function(m, indent = "", isLast = true)
    // Box Drawing Characters
    vLine = char(9474)  // │
    tSplit = char(9500) // ├
    hLine = char(9472)  // ─
    lCorner = char(9492) // └

    if typeof(m) != "map" then 
        connector = tSplit + hLine
        if isLast then connector = lCorner + hLine
        print(indent + connector + "<color=#FFFFCC>" + m + "</color>")
        return
    end if

    keys = m.indexes
    for i in keys.indexes
        k = keys[i]
        lastItem = (i == keys.len - 1)
        
        branch = tSplit + hLine
        if lastItem then branch = lCorner + hLine
        print(indent + branch + "<b><color=#9F4BFF>" + k + "</color></b>")
        
        nextIndent = indent + vLine + "   "
        if lastItem then nextIndent = indent + "    "
        
        PrintTree(m[k], nextIndent, lastItem)
    end for
end function


// Returns [is_custom, output]
// output is `null` by default
CustomCommand = function(cmd,param)
    print(cmd)
    print(param)
    is_custom = false
    output = null
    if cmd == "juice" then
        
        is_custom = true
        if param.len < 1 or param.len > 2 then
            print("Usage: juice <ip-address> <port (optional)>")
            print("* Obtains & stores library memory info")
            print("* Used before [squeeze]")
        else
            //
            ipaddr = param[0]
            if typeof(ipaddr) == "string" then
                oldipaddr = ipaddr
                ipaddr = nslookup(ipaddr)
                if ipaddr == "IP not found" then
                    ipaddr = oldipaddr
                else 
                    print("> "+ipaddr)
                end if
            end if

            isLanIp = is_lan_ip( ipaddr )
            ports = null
            firewallRules = null
            router = null

            router = RouterCheck(ipaddr, isLanIp)
            if typeof(router) == string then // if ip invalid
                return [is_custom, output]
            end if
            ports = PortCheck(router, isLanIp)

            FirewallScan(router)
            PortScan(router, ports, isLanIp)

            portSel = null
            portLAN = null

            if param.len == 2 then
                portTarg = PortSelect(ipaddr, ports, param[1])
            else
                portTarg = PortSelect(ipaddr, ports)
            end if
            portSel = portTarg[0]
            portLAN = portTarg[1]
            if debug_text then print("Grabbing MetaLib...")
            meta_dependencies = MetaGrab(ipaddr, portSel, metaxploit)
            netses = meta_dependencies[0]
            metaLib = meta_dependencies[1]
            if debug_text then print("Scanning memory...")
            listMem = MemScan(metaLib)
            
            mapExploit = {}
            for itemMem in listMem
                if debug_text then print("Scanning ["+itemMem+"]...")
                memScan = metaxploit.scan_address(metaLib, itemMem)
                ret = VulnerableScan(memScan)
                mapExploit[itemMem] = ret
            end for
            output = {"mems":mapExploit,"port_targ":portTarg,"ipaddr":ipaddr,"metaLib":metaLib,"ports":ports} 
            //
        end if
    else if cmd == "squeeze" then
        is_custom = true
        if param.len < 1 or param.len > 2 then
            print("Usage: squeeze -r")
            print("       squeeze <ip address> <port>")
            print("* Cracks the library in said port")
            print("* -r flag uses output from recent [juicr] command")
        else
            //
            lib_id = null
            ipaddr = null
            localipaddr = null
            port = null
            if param.len == 1 then
                if param[0] != "-r" then
                    print("Usage: squeeze -r")
                    print("       squeeze <ip address> <port>")
                    print("* Cracks the library in said port")
                    print("* -r flag uses output from recent [juicr] command")
                    return [is_custom, null]
                end if
                lib_id = ses[cur_ses_key].last_juice
                ipaddr = ses[cur_ses_key].last_targ[0]
                localipaddr = ses[cur_ses_key].last_targ[1]
                port = ses[cur_ses_key].last_targ[2]
            else
                ipaddr = param[0]
                if typeof(ipaddr) == "string" then
                    oldipaddr = ipaddr
                    ipaddr = nslookup(ipaddr)
                    if ipaddr == "IP not found" then
                        ipaddr = oldipaddr
                    else 
                        print("> "+ipaddr)
                    end if
                end if
                port = param[1]
                if not ses.hasIndex(ipaddr) then 
                    print("IP Address not juiced > IP not logged")
                    return [is_custom, null]
                end if
                if not ses[ipaddr].hasIndex("ports") then
                    print("IP Address not juiced > Missing ports list")
                    return [is_custom, null]
                end if
                if port == 0 then
                    localipaddr = ipaddr
                else
                    for targ_port in ses[ipaddr].ports
                        if targ_port.port_number == val(port) then
                            port = val(port)
                            localipaddr = targ_port.get_lan_ip
                        end if
                    end for
                end if
                if not ses[ipaddr].hasIndex(localipaddr) then
                    print("Target IP not juiced > Not in exposed ports")
                    return [is_custom, null]
                end if
                if not ses[ipaddr][localipaddr].hasIndex(str(port)) then
                    print("Target port not juiced > Not in ports list") //not sure how this would happen asides from human error, just a safe catch
                    return [is_custom, null]
                end if
                lib_id = ses[ipaddr][localipaddr][str(port)].lib_key
            end if
            print_style("Type [-r] anytime to return to shell")
            print_style("Type [-n] for no password")
            print(localipaddr+"@"+ipaddr+":"+port)
            print("Lib key obtained: "+lib_id)
            // Password
            passwordArg = user_input("New password > ")
            if passwordArg == "-r" then
                print("User exit")
                return [is_custom, null]
            end if
            if passwordArg == "-n" then passwordArg = ""
            if passwordArg == "" then print("No password in use, Password exploits are disabled.")
            // Post-key
            if not ses.juice_output.hasIndex(lib_id) then
                print("Error: Library details not found in juice_output.")
                return [is_custom, null]
            end if
            lib_data = ses.juice_output[lib_id]
            mems = lib_data.mems
            // selectable list: MemoryAddr >> Vulnerability
            options = []
            for memAddr in mems.indexes
                for vulnName in mems[memAddr].indexes
                    options.push(memAddr + " >> " + vulnName)
                end for
            end for
            // Display Selection Menu
            isSqueezing = true
            results = {}
            while isSqueezing
                //clear_screen()
                print("\n<b>Available exploits for " + lib_id + ":</b>")
                for i in options.indexes
                    parts = options[i].split(" >> ")
                    addr = parts[0]
                    vuln = parts[1]
                    
                    // Proper nested lookup
                    reqs = mems[addr][vuln]
                    
                    req_str = ""
                    col = ""
                    res_type = "" 
                    outcome = null
                    if reqs.len > 0 then req_str = " <color=orange>(" + reqs.len + " reqs)</color>"
                    if results.hasIndex(vuln+"@"+addr) then
                        if not results[vuln+"@"+addr][0] then
                            col = "<color=red>"
                        else
                            col = "<color=yellow>"
                            res_type = " <color=green>(Type ["+typeof(results[vuln+"@"+addr][0])+"])</color>"
                        end if
                        outcome = results[vuln+"@"+addr][1]
                        if outcome != null then col = "<color=green>"
                    end if
                    print(col+"[" + i + "] </color>" + options[i] + req_str + res_type)
                    if outcome != null then print(outcome)
                end for
                print("Select Index")
                print("q - exit")
                print("bf - brute-force")
                selection = user_input(">> ")
                if selection == "q" then 
                    isSqueezing = false
                    continue
                end if
                
                sel_idx = val(selection)
                if not options.hasIndex(sel_idx) then
                    print("Invalid selection.")
                    continue
                end if

                target_exploit = options[sel_idx].split(" >> ")
                mem_addr = target_exploit[0]
                vuln_name = target_exploit[1]
                
                if results.hasIndex(vuln_name+"@"+mem_addr) then
                    result_data = results[vuln_name+"@"+mem_addr]
                    result = result_data[0]
                    print("Launching " + vuln_name + " at " + mem_addr + "...")
                    if typeof(result) == "computer" then HandleComputerObj(result, true)
                    if typeof(result) == "shell" then
                        if port == 0 then
                            print("Port 0: Handling target as Router...")
                            HandleRouter(result)
                        else
                            print("Port "+port+": Handling target as standard shell...")
                            result.start_terminal
                        end if
                    end if
                    if typeof(result) == "file" then
                        stdout = ""
                        stdout = stdout + (result.permissions+" | "+result.path+" | "+result.size+" bytes\nOwner "+result.owner)
                        filetype = "File"
                        if result.is_binary then filetype = "Binary"
                        if result.is_folder then filetype = "Folder"
                        stdout = stdout + " | Type: "+filetype
                        if result.is_folder then
                            for file in result.get_files
                                stdout = stdout + ("File "+file.path)+"\n"
                            end for
                        else if not result.is_binary then
                            stdout = stdout + ("Contents: ["+result.get_content+"]")+"\n"
                        end if
                        result_data[1] = stdout
                    end if
                    if typeof(result) == "password" then
                        result_data[1] = result
                    end if
                    results[vuln_name+"@"+mem_addr][1] = result_data[1]
                    continue
                end if

                print("Targeting " + vuln_name + " at " + mem_addr + "...")
                
                mLib = lib_data.metaLib
                result = mLib.overflow(mem_addr, vuln_name, passwordArg)

                if result then
                    print("<color=green>Success!</color> Gained " + typeof(result))
                    results[vuln_name+"@"+mem_addr] = [result, null]
                else
                    print("<color=red>Exploit failed.</color> Try another address.")
                    results[vuln_name+"@"+mem_addr] = [false, null]
                end if
            end while
            //
        end if
    else if cmd == "print_ses" then
        is_custom = true
        PrintTree(ses)
    else if cmd == "help" then
        is_custom = true
        print_style("Available commands:")
        print_style("juice <ip-address> <port (optional)>")
        print_style("* Obtains & stores library memory info")
        print_style("* Used before [squeeze]")
        print_style("squeeze -r")
        print_style("squeeze <ip address> <port>")
        print_style("* Cracks the library in said port")
        print_style("* -r flag uses output from recent [juicr] command")
        print_style("print_ses")
        print_style("* Debug command. Prints map [ses]")
    end if
    return [is_custom, output]
end function

// Iteratively moves through keys, creating maps if they don't exist
EnsurePath = function(m, keys)
    curr = m
    for k in keys
        // Use string conversion to ensure keys work as map indexes
        kStr = str(k) 
        if not curr.hasIndex(kStr) then curr[kStr] = {}
        curr = curr[kStr]
    end for
    return curr
end function

BufferStore = function(stdin, command_output)
    if stdin[0] == "juice" then
        output = command_output[1]
        ses_path = [output.ipaddr, output.port_targ[1], output.port_targ[0]] //stores target than attacker
        lib_path = ["juice_output", output.metaLib.lib_name + "v" + output.metaLib.version]
        
        sesbuffer = EnsurePath(ses, ses_path)
        buffer = EnsurePath(ses, lib_path)

        sesbuffer.lib_key = output.metaLib.lib_name + "v" + output.metaLib.version
        sesbuffer.date = current_date

        buffer.metaLib = output.metaLib
        buffer.mems = output.mems
        buffer.date = current_date
        ses[cur_ses_key].last_juice = sesbuffer.lib_key
        ses[cur_ses_key].last_targ = ses_path
        ses[output.ipaddr].ports = output.ports
        print("Stored vulnerables for lib "+output.metaLib.lib_name + "v" + output.metaLib.version)
    end if
end function

while running
	print("<color=grey>"+char(9484)+char(9472)*2+"<color=#9F4BFF>"+cur_ses_key)
	print("<color=grey>"+char(9500)+char(9472)+"<color=#3366FF>"+active_user+"@"+cmp.get_name)
	stdin = user_input("<color=grey>"+char(9492)+"</color><color=#00FF00>"+current_path+"</color>:<color=#3366FF>></color> ", false, false, true).split(" ")
	prg_param = stdin[1:]
    prg_param_raw = prg_param
	if prg_param.len == 0 then
		prg_param = ""
	else
		prg_param = prg_param.join(" ")
	end if
    command_output = CustomCommand(stdin[0], prg_param_raw)
    if command_output[0] then
        if command_output[1] != null then
            BufferStore(stdin, command_output)
        end if
    else
        exec = cmp.File("/bin/" + stdin[0])
        exec2 = cmp.File(current_path+"/"+stdin[0])
        if exec != null then
            TryLaunch(exec)
        else if exec2 != null then
            TryLaunch(exec2)
        else
            print(stdin[0]+": does not exist")
        end if
    end if
end while