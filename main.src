//////////////////////////////

debug_text = true
clearScreen = false

OldCore = function()
    TitleScreen()

    CachePrep()

    print_style("Type [-q] anytime to quit")
    print_style("Type [-n] for no password")

    // Prep
    isLanIp = is_lan_ip( ipaddr )
    passwordArg = user_input("New password > ")
    ports = null
    firewallRules = null
    router = null

    if passwordArg == "-q" then exit("User exit")
    if passwordArg == "-n" then passwordArg = ""
    if passwordArg == "" then print("No password in use, Password exploits are disabled.")

    router = RouterCheck(ipaddr)
    ports = PortCheck(router)

    FirewallScan(router)
    PortScan(ports)

    portSel = null
    portLAN = null

    portTarg = PortSelect(ports)
    portSel = portTarg[0]
    portLAN = portTarg[1]

    metaxploit = null
    cryptools = null
    netses = null
    metalib = null
    listMem = null

    dependencies = LibGrab()
    metaxploit = dependencies[0]
    cryptools = dependencies[1]
    meta_dependencies = MetaGrab(metaxploit)
    netses = meta_dependencies[0]
    metalib = meta_dependencies[1]
    listMem = MemScan(metaLib)

    mapExploit = {}
    for itemMem in listMem
        if debug_text then print("Scanning ["+itemMem+"]...")
        memScan = metaxploit.scan_address(metaLib, itemMem)
        ret = VulnerableScan(memScan)
        mapExploit[itemMem] = ret
    end for

    exploitCount = 0
    for mem in mapExploit
        for itemKey in mem
            exploitCount += 1
        end for
    end for

    successKeys = TryExploit(mapExploit)
    chosen_string = SelectExploit(successKeys)
    PostScanInterface(chosen_string)
    CacheRemove()
    //print(ReqSearch(mapExploit, "note"))
    exit("<color=#391D46>==<color=#FFAA00>JUICR</color>==</color> closed")
end function

metaxploit = null
cryptools = null
